# Django defaults target a separately managed local PostgreSQL instance.
# scripts/dev.sh instead exports a private Unix socket database automatically.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PGDATABASE=netrunner
PGUSER=netrunner
PGHOST=127.0.0.1
PGPORT=5432
# Set PGPASSWORD and a unique DJANGO_SECRET_KEY securely for deployment.
# This file is a reference; Django reads exported environment variables.
